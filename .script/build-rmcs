#!/bin/bash

source /opt/ros/jazzy/setup.bash

: "${RMCS_PATH:=/workspaces/RMCS}"

if [[ ! -d "${RMCS_PATH}/rmcs_ws" ]]; then
    echo "> ERROR: Workspace not found: ${RMCS_PATH}/rmcs_ws"
    exit 1
fi

cd "${RMCS_PATH}"/rmcs_ws || exit 1

# 限制开发机器上的编译内存占用。这里设置每个包内的并行任务数，
# 包之间的并行数量由 colcon 的执行器控制。
: "${RMCS_BUILD_JOBS:=1}"
if [[ ! "${RMCS_BUILD_JOBS}" =~ ^[1-9][0-9]*$ ]]; then
    echo "> ERROR: RMCS_BUILD_JOBS must be a positive integer."
    exit 1
fi

# MAKEFLAGS 同时阻止 colcon 根据 CPU 核数自动添加 -j 参数。
# CMAKE_BUILD_PARALLEL_LEVEL 对 Make 和 Ninja 生成器均生效。
export CMAKE_BUILD_PARALLEL_LEVEL="${RMCS_BUILD_JOBS}"
export MAKEFLAGS="${MAKEFLAGS:+${MAKEFLAGS} }-j${RMCS_BUILD_JOBS}"
echo "> Build jobs per package: ${RMCS_BUILD_JOBS} (default executor: sequential)"

[[ -x /opt/cmake/bin/cmake ]] &&
    export PATH="/opt/cmake/bin:$PATH"

cmake_toolchain_args=()
event_handlers_args=()

if [[ "${RMCS_USE_LLVM}" == "ON" ]]; then
    missing_tools=()
    for tool in clang clang++ llvm-ar llvm-ranlib ld.lld ninja; do
        if ! command -v "${tool}" &>/dev/null; then
            missing_tools+=("${tool}")
        fi
    done

    if ((${#missing_tools[@]} > 0)); then
        echo "> ERROR: LLVM toolchain is required when RMCS_USE_LLVM=ON."
        echo "> Missing tools: ${missing_tools[*]}"
        echo "> Install the missing tools, or set RMCS_USE_LLVM=OFF to build with GCC."
        exit 1
    fi

    echo "> Compiling With LLVM ToolChain"
    export CC=clang
    export CXX=clang++
    cmake_toolchain_args=(
        "-GNinja"
        "-DCMAKE_MESSAGE_LOG_LEVEL=ERROR"
        "-DCMAKE_EXE_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_SHARED_LINKER_FLAGS=-fuse-ld=lld"
        "-DCMAKE_AR=$(command -v llvm-ar)"
        "-DCMAKE_RANLIB=$(command -v llvm-ranlib)"
    )
    event_handlers_args=(
        --event-handlers console_cohesion+
    )
fi

colcon_args=(
    --symlink-install --merge-install
    --executor sequential
    "${event_handlers_args[@]}"
)
cmake_args=(
    "${cmake_toolchain_args[@]}"
)

CLICOLOR_FORCE=1 NINJA_STATUS="" \
    colcon build "${colcon_args[@]}" "$@" --cmake-args "${cmake_args[@]}"
